---
import { site } from "../data/site";
---

<header
  class="sticky top-0 z-50 border-b border-lilac-200/60 bg-lilac-50/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a
      href="#top"
      class="font-display text-2xl leading-none text-lilac-700"
      aria-label="AgendaLila — inicio">{site.name}</a
    >

    <!-- Desktop links -->
    <div class="hidden items-center gap-8 md:flex">
      {
        site.nav.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-lilac-700/80 transition-colors hover:text-lilac-700"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <!-- Desktop CTA — bg-lilac-700 (#725f94) is the AA-safe interactive color -->
    <a
      href={site.cta.href}
      class="hidden items-center gap-1.5 rounded-full bg-lilac-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-lilac-800 md:inline-flex"
    >
      {site.cta.label}
      <svg
        width="14"
        height="14"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="8" x2="13" y2="8"></line>
        <path d="M9 4L13 8L9 12"></path>
      </svg>
    </a>

    <!-- Mobile hamburger — 44×44 touch target -->
    <button
      data-nav-toggle
      class="inline-flex h-11 w-11 items-center justify-center text-lilac-700 md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="13" x2="20" y2="13"></line>
        <line x1="4" y1="19" x2="20" y2="19"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div
    id="mobile-drawer"
    hidden
    class="border-t border-lilac-200/60 bg-lilac-50 px-5 py-4 md:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        site.nav.map((l) => (
          <a
            href={l.href}
            data-nav-link
            class="rounded-lg px-3 py-3 text-base font-medium text-lilac-700 hover:bg-lilac-100"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={site.cta.href}
        data-nav-link
        class="mt-2 inline-flex items-center justify-center rounded-full bg-lilac-700 px-5 py-3 text-base font-semibold text-white"
        >{site.cta.label}</a
      >
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const drawer = document.getElementById("mobile-drawer");
  if (toggle && drawer) {
    const close = () => {
      drawer.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú");
    };
    toggle.addEventListener("click", () => {
      const willOpen = drawer.hasAttribute("hidden");
      if (willOpen) {
        drawer.removeAttribute("hidden");
        toggle.setAttribute("aria-expanded", "true");
        toggle.setAttribute("aria-label", "Cerrar menú");
      } else {
        close();
      }
    });
    drawer
      .querySelectorAll("[data-nav-link]")
      .forEach((a) => a.addEventListener("click", close));
  }
</script>
