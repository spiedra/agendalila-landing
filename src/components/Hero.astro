---
import { hero } from "../data/hero";
import Eyebrow from "./Eyebrow.astro";
---

<section id="top" class="relative overflow-hidden">
  {/* Ambient warm-lilac glow — subtle, NOT an AI purple→blue gradient */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background:
      radial-gradient(circle at 80% 10%, rgba(174,150,208,0.22), transparent 55%),
      radial-gradient(circle at 15% 90%, rgba(212,188,222,0.30), transparent 50%);"
  >
  </div>

  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 md:py-24 lg:grid-cols-[1.05fr_1fr]"
  >
    {/* ── Left: copy ── */}
    <div>
      <Eyebrow>{hero.eyebrow}</Eyebrow>

      <h1
        class="mt-4 font-display text-[clamp(2.1rem,5.2vw,3.6rem)] leading-[1.05] text-lilac-900"
      >
        {hero.headingLead}{" "}
        <em
          class="not-italic text-lilac-700"
          style="background-image:linear-gradient(transparent 62%, color-mix(in srgb, var(--brand-decor) 42%, transparent) 0);"
          >{hero.headingAccent}</em
        >.
      </h1>

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-lilac-800/85">
        {hero.lede}
      </p>

      {/* Rubro chips — signal who it's for (incl. Barberías) in 5 seconds */}
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Para qué negocios">
        {
          hero.rubros.map((r) => (
            <li class="rounded-full border border-lilac-300 bg-white/60 px-3.5 py-1.5 text-sm font-medium text-lilac-700">
              {r}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={hero.ctaPrimary.href}
          class="inline-flex items-center gap-1.5 rounded-full bg-lilac-700 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-lilac-800"
        >
          {hero.ctaPrimary.label}
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="8" x2="13" y2="8"></line>
            <path d="M9 4L13 8L9 12"></path>
          </svg>
        </a>
        <a
          href={hero.ctaGhost.href}
          class="inline-flex items-center rounded-full border border-lilac-300 px-6 py-3 text-base font-semibold text-lilac-700 transition-colors hover:bg-lilac-100"
        >
          {hero.ctaGhost.label}
        </a>
      </div>

      <p class="mt-6 flex items-center gap-2 text-sm text-lilac-700/70">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M9 12l2 2 4-4"></path>
        </svg>
        <span set:html={hero.meta}></span>
      </p>
    </div>

    {/* ── Right: layered peek into the real product ──
        Desktop: tile-1 in flow + tiles 2/3 absolute, overlapping, rotated,
        hover-lift (matches the Claude Design composition). Mobile: clean
        vertical stack (no overflow). Decorative → aria-hidden. */}
    <div
      aria-hidden="true"
      class="relative mx-auto w-full max-w-[460px] lg:mx-0 lg:min-h-[500px]"
    >
      <div class="flex flex-col gap-4 lg:block lg:gap-0">
        {/* Tile 1 — today's agenda (base) */}
        <div
          class="relative z-30 rounded-2xl border border-lilac-200 bg-white p-5 shadow-[var(--shadow-lg)] lg:w-[300px]"
        >
          <p
            class="text-[9px] font-bold uppercase tracking-[0.16em] text-lilac-700/55"
          >
            Citas hoy · martes 17
          </p>
          <div
            class="mt-1 text-[44px] font-extrabold leading-none tracking-[-0.04em] text-lilac-900"
          >
            12
          </div>
          <div class="mt-2 flex gap-4 text-xs text-lilac-700/70">
            <span class="flex items-center gap-1.5">
              <span class="inline-block h-2 w-2 rounded-full bg-lilac-500"
              ></span>8 completadas</span
            >
            <span class="flex items-center gap-1.5">
              <span class="inline-block h-2 w-2 rounded-full bg-lilac-200"
              ></span>4 pendientes</span
            >
          </div>
          <div class="my-3 h-px bg-lilac-200"></div>
          <p
            class="text-[9px] font-bold uppercase tracking-[0.16em] text-lilac-700/50"
          >
            Próxima
          </p>
          <div class="mt-1.5 flex items-center gap-3">
            <div class="min-w-0 flex-1">
              <div class="text-sm font-semibold text-lilac-900">
                Saskia Solano
              </div>
              <div class="truncate text-xs text-lilac-700/70">
                Pestañas voluminosas · Estefanía
              </div>
            </div>
            <span
              class="rounded-full bg-lilac-700/10 px-2.5 py-1 text-[11px] font-semibold text-lilac-700"
              >14:00</span
            >
          </div>
        </div>

        {/* Tile 2 — WhatsApp reminder (overlap, +2°) */}
        <div
          class="relative z-40 rounded-2xl border border-lilac-200 bg-white p-4 shadow-[var(--shadow-xl)] transition-transform duration-300 hover:-translate-y-1 lg:absolute lg:top-[44%] lg:-right-3 lg:w-[248px] lg:rotate-2"
        >
          <p
            class="mb-2 text-[9px] font-bold uppercase tracking-[0.16em] text-lilac-700/55"
          >
            Recordatorio · 18:00
          </p>
          <div
            class="rounded-2xl px-3 py-2.5 text-xs leading-relaxed"
            style="background:#d3f9d8;color:#1d4b2d;"
          >
            Hola Saskia 💜 te recordamos tu cita mañana a las 14:00 en Amorelila.
            ¡Te esperamos!
          </div>
          <div class="mt-1.5 text-right text-[10px] text-lilac-700/55">
            Enviado por AgendaLila
          </div>
        </div>

        {/* Tile 3 — branded booking page, richer (overlap, -2°) */}
        <div
          class="relative z-20 rounded-2xl border border-lilac-200 bg-white p-4 shadow-[var(--shadow-xl)] transition-transform duration-300 hover:-translate-y-1 lg:absolute lg:-bottom-3 lg:-left-3 lg:w-[252px] lg:-rotate-2"
        >
          <p
            class="text-[9px] font-bold uppercase tracking-[0.16em] text-lilac-700/55"
          >
            Tu página · book/amorelila
          </p>
          {/* salon header */}
          <div class="mt-2 flex items-center gap-2">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-display text-base lowercase text-white"
              style="background:var(--brand);">a</span
            >
            <div class="min-w-0">
              <div
                class="truncate font-display text-sm leading-none text-lilac-700"
              >
                Amorelila Estética
              </div>
              <div class="mt-0.5 text-[9px] text-lilac-700/55">
                Curridabat · San José
              </div>
            </div>
          </div>
          {/* services */}
          <div class="relative mt-2.5 overflow-hidden rounded-lg bg-lilac-50 p-2">
            <span
              class="absolute left-0 top-0 h-[3px] w-6"
              style="background:var(--service-pestanas);"></span>
            <div class="text-[11px] font-semibold text-lilac-900">
              Extensión de pestañas
            </div>
            <div
              class="mt-0.5 flex justify-between text-[10px] text-lilac-700/70"
            >
              <span>90 min</span><span class="font-semibold text-lilac-700"
                >₡24.300</span
              >
            </div>
          </div>
          <div class="relative mt-1.5 overflow-hidden rounded-lg bg-lilac-50 p-2">
            <span
              class="absolute left-0 top-0 h-[3px] w-6"
              style="background:var(--service-unas);"></span>
            <div class="text-[11px] font-semibold text-lilac-900">
              Manicura con Gel X
            </div>
            <div
              class="mt-0.5 flex justify-between text-[10px] text-lilac-700/70"
            >
              <span>75 min</span><span class="font-semibold text-lilac-700"
                >₡16.950</span
              >
            </div>
          </div>
          {/* reserve button */}
          <div
            class="mt-2.5 flex h-8 items-center justify-center gap-1 rounded-lg text-[11px] font-semibold text-white"
            style="background:var(--brand);"
          >
            Reservar
            <svg
              width="12"
              height="12"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><line x1="3" y1="8" x2="13" y2="8"></line><path d="M9 4L13 8L9 12"
              ></path></svg
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
