---
// Small uppercase kicker above a heading. One source of truth for the eyebrow
// treatment so every section matches the design token exactly:
//   --text-eyebrow: 700 10px/1.2 + letter-spacing 3px + uppercase + brand color.
// Brand color (lilac-700) is the interactive/strong tone — AA-safe, not the
// decorative lilac-500.
interface Props {
  class?: string;
  // "brand" (default) on light backgrounds; "light" for dark/gradient sections.
  tone?: "brand" | "light";
}
const { class: className, tone = "brand" } = Astro.props;
const color = tone === "light" ? "text-lilac-300" : "text-lilac-700";
---

<span
  class:list={[
    "inline-block text-[10px] font-bold uppercase tracking-[0.3em]",
    color,
    className,
  ]}
>
  <slot />
</span>
