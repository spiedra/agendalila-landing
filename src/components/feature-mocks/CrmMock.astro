---
// CRM feature mock — a client record with fields and tags.
const fields = [
  { lbl: "Última visita", v: "17 mar · pestañas" },
  { lbl: "Servicios favoritos", v: "Pestañas, cejas" },
  { lbl: "Total gastado", v: "₡412.000" },
  { lbl: "Cumpleaños", v: "3 de julio" },
];
const tags = ["VIP", "Alérgica al látex", "Prefiere natural"];
---

<div class="w-full max-w-[320px] rounded-2xl bg-white px-5 py-[18px] shadow-[var(--shadow-md)]">
  <div class="mb-3.5 flex items-center gap-3 border-b border-lilac-200 pb-3.5">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lilac-700 font-semibold text-white">
      SS
    </div>
    <div>
      <div class="text-sm font-semibold text-lilac-900">Saskia Solano</div>
      <div class="text-[11px] text-lilac-700/70">Clienta desde abril 2024 · 14 visitas</div>
    </div>
  </div>
  {
    fields.map((f) => (
      <div class="flex justify-between py-1.5 text-xs">
        <span class="text-lilac-700/70">{f.lbl}</span>
        <span class="font-medium text-lilac-900">{f.v}</span>
      </div>
    ))
  }
  <div class="mt-2 flex flex-wrap gap-1">
    {
      tags.map((t) => (
        <span
          class="rounded-full px-2 py-[3px] text-[10px] font-medium text-lilac-700"
          style="background:color-mix(in srgb, var(--brand-decor) 18%, white);"
        >
          {t}
        </span>
      ))
    }
  </div>
</div>
