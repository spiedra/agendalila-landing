---
// Metrics feature mock — a revenue stat with a build-time-computed sparkline.
const W = 280,
  H = 50,
  pad = 4;
const data = [12, 14, 11, 15, 18, 20, 17, 22, 19, 24, 26, 24, 28, 30, 33, 31, 35];
const max = Math.max(...data),
  min = Math.min(...data);
const step = (W - pad * 2) / (data.length - 1);
const points = data.map((v, i) => [
  pad + i * step,
  H - pad - ((v - min) / (max - min || 1)) * (H - pad * 2),
]);
const line = points
  .map((p, i) => (i === 0 ? `M ${p[0]},${p[1]}` : `L ${p[0]},${p[1]}`))
  .join(" ");
const fill = `${line} L ${W - pad},${H} L ${pad},${H} Z`;
---

<div class="w-full max-w-[320px] rounded-2xl bg-white px-5 py-[18px] shadow-[var(--shadow-md)]">
  <div class="mb-1.5 flex items-baseline justify-between">
    <span class="text-[9px] font-bold uppercase tracking-[2px] text-lilac-700/70">
      Ingresos · marzo
    </span>
    <span class="text-xs font-semibold text-success">↑ 18%</span>
  </div>
  <div class="text-[36px] font-extrabold leading-none tracking-[-1.5px] text-lilac-900">
    ₡3.4M
  </div>
  <div class="mt-1 text-xs text-lilac-700/70">vs ₡2.9M en febrero</div>
  <svg class="mt-3.5 h-[54px] w-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="msg" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%" stop-color="var(--brand)" stop-opacity="0.3"></stop>
        <stop offset="100%" stop-color="var(--brand)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <path d={fill} fill="url(#msg)"></path>
    <path d={line} fill="none" stroke="var(--brand)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</div>
