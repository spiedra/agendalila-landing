---
// Booking-page feature mock — a branded mini booking card (salon header,
// two category-coloured services, reserve button).
---

<div class="relative w-full max-w-[280px] rounded-[20px] bg-white p-5 shadow-[var(--shadow-md)]">
  <div class="mb-3.5 flex items-center gap-2.5">
    <div
      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full font-display text-[17px] text-white"
      style="background:var(--brand);"
    >
      a
    </div>
    <div>
      <div class="text-[13px] font-semibold text-lilac-900">Amorelila Estética</div>
      <div class="text-[10px] text-lilac-700/70">Curridabat · San José</div>
    </div>
  </div>
  <div class="mb-2 text-center font-display text-[18px] leading-[1.1] text-lilac-700">
    Reservá tu cita
  </div>
  {/* Service 1 — pestañas */}
  <div class="relative mb-2 overflow-hidden rounded-xl bg-lilac-50 p-3">
    <span class="absolute left-0 top-0 h-[3px] w-6" style="background:var(--service-pestanas);"></span>
    <div class="mb-1 text-xs font-semibold text-lilac-900">Extensión de pestañas</div>
    <div class="flex justify-between text-[10px] text-lilac-700/70">
      <span>90 min</span><span class="font-semibold text-lilac-700">₡24.300</span>
    </div>
  </div>
  {/* Service 2 — uñas */}
  <div class="relative mb-2 overflow-hidden rounded-xl bg-lilac-50 p-3">
    <span class="absolute left-0 top-0 h-[3px] w-6" style="background:var(--service-unas);"></span>
    <div class="mb-1 text-xs font-semibold text-lilac-900">Manicura con Gel X</div>
    <div class="flex justify-between text-[10px] text-lilac-700/70">
      <span>75 min</span><span class="font-semibold text-lilac-700">₡16.950</span>
    </div>
  </div>
  <div
    class="mt-2.5 flex h-[30px] items-center justify-center gap-1 rounded-lg text-[11px] font-semibold text-white"
    style="background:var(--brand);"
  >
    Reservar
    <svg
      width="12"
      height="12"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="3" y1="8" x2="13" y2="8"></line><path d="M9 4L13 8L9 12"></path>
    </svg>
  </div>
</div>
