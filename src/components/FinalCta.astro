---
import Eyebrow from "./Eyebrow.astro";
import { cta } from "../data/cta";

const labelClass =
  "text-[11px] font-semibold uppercase tracking-[1px] text-lilac-200";
const fieldClass =
  "h-11 rounded-[10px] border border-white/20 bg-white/10 px-3.5 text-sm text-white outline-none transition placeholder:text-white/50 focus:border-white focus:bg-white/20 focus:ring-[3px] focus:ring-white/10";
// Dropdown options render on the browser's (light) menu, so force dark text.
const selectClass = `${fieldClass} [&>option]:text-lilac-900`;
---

<section
  id="solicitar"
  class="relative overflow-hidden px-6 text-white"
  style="background: linear-gradient(135deg, var(--color-lilac-700) 0%, var(--color-lilac-800) 100%);"
>
  {/* Ambient glows (decorative) */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-[100px] -top-[100px] h-[360px] w-[360px] rounded-full"
    style="background: radial-gradient(circle, rgba(212,188,222,0.24) 0%, transparent 70%);"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-[100px] -right-[100px] h-[380px] w-[380px] rounded-full"
    style="background: radial-gradient(circle, rgba(174,150,208,0.20) 0%, transparent 70%);"
  >
  </div>

  <div
    class="relative z-[1] mx-auto grid max-w-[1140px] items-center gap-9 py-20 min-[820px]:grid-cols-2 min-[820px]:gap-[60px]"
  >
    {/* Pitch */}
    <div>
      <Eyebrow tone="light">{cta.eyebrow}</Eyebrow>
      <h2
        class="mb-4 mt-3 font-display text-[clamp(2rem,4.5vw,2.75rem)] font-normal leading-[1.15] tracking-[-0.01em] text-white"
      >
        {cta.title}
      </h2>
      <p class="mb-[22px] max-w-[460px] text-base leading-[1.6] text-lilac-200">
        {cta.intro}
      </p>
      <p class="text-[13px] text-lilac-300">
        {cta.secondaryPre}<a
          href={cta.secondaryHref}
          class="text-white underline underline-offset-2 hover:text-lilac-100"
          >{cta.secondaryLink}</a
        >.
      </p>
    </div>

    {/* Form — glass card */}
    <form
      id="cta-form"
      class="rounded-[24px] border border-white/15 bg-white/[0.07] p-7 backdrop-blur-[10px]"
      novalidate={false}
    >
      <div id="cta-body">
        {/* Honeypot — bots fill this; humans never see or tab to it. */}
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label
            >No completar<input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            /></label
          >
        </div>
        <h3 class="mb-4 text-base font-semibold text-white">{cta.formHeading}</h3>

        <div class="flex flex-col gap-3.5">
          <div class="flex flex-col gap-[5px]">
            <label class={labelClass} for="cta-nombre">Nombre</label>
            <input
              class={fieldClass}
              id="cta-nombre"
              name="nombre"
              type="text"
              required
              placeholder="Tu nombre completo"
            />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div class="flex flex-col gap-[5px]">
              <label class={labelClass} for="cta-whatsapp">WhatsApp</label>
              <input
                class={fieldClass}
                id="cta-whatsapp"
                name="whatsapp"
                type="tel"
                required
                placeholder="+506 …"
              />
            </div>
            <div class="flex flex-col gap-[5px]">
              <label class={labelClass} for="cta-pais">País</label>
              <select class={selectClass} id="cta-pais" name="pais" required>
                <option value="" disabled selected>Elegí…</option>
                {cta.paises.map((p) => <option>{p}</option>)}
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-[5px]">
            <label class={labelClass} for="cta-negocio">Nombre del negocio</label>
            <input
              class={fieldClass}
              id="cta-negocio"
              name="negocio"
              type="text"
              required
              placeholder="Tu salón / barbería / estudio"
            />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div class="flex flex-col gap-[5px]">
              <label class={labelClass} for="cta-rubro">Rubro</label>
              <select class={selectClass} id="cta-rubro" name="rubro" required>
                <option value="" disabled selected>Elegí…</option>
                {cta.rubros.map((r) => <option>{r}</option>)}
              </select>
            </div>
            <div class="flex flex-col gap-[5px]">
              <label class={labelClass} for="cta-equipo">Equipo</label>
              <select class={selectClass} id="cta-equipo" name="equipo" required>
                <option value="" disabled selected>Tamaño…</option>
                {cta.equipos.map((e) => <option>{e}</option>)}
              </select>
            </div>
          </div>

          <button
            type="submit"
            class="mt-1.5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-white px-3.5 py-3.5 text-[15px] font-semibold text-lilac-700 transition hover:-translate-y-px hover:bg-lilac-150"
          >
            {cta.submit}
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="3" y1="8" x2="13" y2="8"></line><path d="M9 4L13 8L9 12"
              ></path>
            </svg>
          </button>
          <p class="mt-3 text-center text-[11px] text-lilac-300">{cta.note}</p>
          <p
            id="cta-error"
            hidden
            class="mt-2 text-center text-[12px] text-[#ffb9c4]"
          >
            No se pudo enviar. Probá de nuevo o escribinos a info@agendalila.com.
          </p>
        </div>
      </div>

      {/* Success state — revealed on submit */}
      <div id="cta-success" hidden class="px-2 py-8 text-center">
        <div
          class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white/15"
        >
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12l5 5L20 7"></path>
          </svg>
        </div>
        <h3 class="mb-2 font-display text-2xl font-normal text-white">
          {cta.successTitle}
        </h3>
        <p class="mx-auto max-w-[320px] text-sm leading-[1.55] text-lilac-200">
          {cta.successBody}
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  // POSTs to the /api/request-invite Pages Function (→ D1 leads + Resend).
  const form = document.getElementById("cta-form") as HTMLFormElement | null;
  const body = document.getElementById("cta-body");
  const success = document.getElementById("cta-success");
  const error = document.getElementById("cta-error");
  const submitBtn = form?.querySelector(
    'button[type="submit"]',
  ) as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const payload = Object.fromEntries(new FormData(form).entries());
    if (submitBtn) submitBtn.disabled = true;
    if (error) error.hidden = true;
    try {
      const res = await fetch("/api/request-invite", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error("request failed");
      if (body) body.hidden = true;
      if (success) success.hidden = false;
      success?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    } catch {
      if (submitBtn) submitBtn.disabled = false;
      if (error) error.hidden = false;
    }
  });
</script>
