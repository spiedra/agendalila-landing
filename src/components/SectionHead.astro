---
// Centered section header (eyebrow + h2 + optional lede) shared by every
// content section. Mirrors the design's `.s-section-head`: max-width 720px,
// 56px bottom margin, display-font h2 at weight 400.
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto mb-14 max-w-[720px] text-center">
  {eyebrow && <Eyebrow class="mb-3.5">{eyebrow}</Eyebrow>}
  <h2
    class="font-display text-[clamp(2rem,4.5vw,2.75rem)] font-normal leading-[1.1] tracking-[-0.01em] text-lilac-900"
  >
    {title}
  </h2>
  {
    description && (
      <p class="mt-3.5 text-[17px] leading-[1.6] text-lilac-700/70">
        {description}
      </p>
    )
  }
</div>
